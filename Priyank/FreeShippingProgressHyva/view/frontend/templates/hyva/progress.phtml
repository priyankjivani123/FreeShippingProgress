<script>
function freeShippingProgress() {
    return {
        limit: <?= (float)$config['min_amount'] ?>,
        subtotal: 0,
        percentage: 0,
        summaryText: '',
        showBar: false,
        isClosed: false,
        
        init() {
            this.isClosed = sessionStorage.getItem('freeShippingBarClosed') === 'true';
            this.getCartSubtotal();
            
            window.addEventListener('reload-customer-section-data', () => {
                setTimeout(() => this.getCartSubtotal(), 100);
            });
            
            window.addEventListener('private-content-loaded', () => {
                setTimeout(() => this.getCartSubtotal(), 100);
            });
            
            window.addEventListener('cart-updated', () => {
                setTimeout(() => this.getCartSubtotal(), 100);
            });
            
            this.pollForCart();
        },
        
        closeBar() {
            this.isClosed = true;
            sessionStorage.setItem('freeShippingBarClosed', 'true');
        },
        
        pollForCart() {
            let attempts = 0;
            const maxAttempts = 20;
            const interval = setInterval(() => {
                attempts++;
                if (window.hyva && window.hyva.getCart) {
                    this.getCartSubtotal();
                    clearInterval(interval);
                } else if (attempts >= maxAttempts) {
                    clearInterval(interval);
                    this.fetchCartFromAPI();
                }
            }, 200);
        },
        
        async getCartSubtotal() {
            try {
                if (window.hyva && typeof window.hyva.getCart === 'function') {
                    const cart = await window.hyva.getCart();
                    
                    if (cart) {
                        this.subtotal = parseFloat(
                            cart.subtotalAmount || 
                            cart.subtotal || 
                            cart.subtotal_incl_tax || 
                            cart.subtotal_excl_tax ||
                            0
                        );
                        
                        if (this.subtotal > 0) {
                            this.update();
                            return;
                        }
                    }
                }
                
                await this.fetchCartFromAPI();
                
            } catch (error) {
                await this.fetchCartFromAPI();
            }
        },
        
        async fetchCartFromAPI() {
            try {
                const response = await fetch('http://127.0.0.1/php83/magento248-p3/pub/customer/section/load/?sections=cart&update_section_id=false', {
                    method: 'GET',
                    credentials: 'include',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    
                    if (data.cart) {
                        this.subtotal = parseFloat(
                            data.cart.subtotalAmount || 
                            data.cart.subtotal || 
                            data.cart.subtotal_incl_tax ||
                            data.cart.subtotal_excl_tax ||
                            0
                        );
                        
                        this.update();
                    }
                }
            } catch (error) {
                // Silent fail
            }
        },
        
        update() {
            const remaining = this.limit - this.subtotal;
            this.percentage = Math.min(100, Math.round((this.subtotal / this.limit) * 100));
            
            if (remaining > 0) {
                this.summaryText = `Almost there! You're ₹${remaining.toFixed(2)} away from FREE SHIPPING!`;
            } else {
                this.summaryText = '🎉 Congratulations! You got FREE SHIPPING!';
            }
            
            this.showBar = this.subtotal > 0;
            
            if (this.showBar) {
                this.isClosed = false;
                sessionStorage.removeItem('freeShippingBarClosed');
            }
        }
    }
}
</script>
<?php endif; ?>